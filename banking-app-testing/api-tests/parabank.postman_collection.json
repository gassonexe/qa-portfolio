                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "API-TRF-004 Transfer more than the available balance",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transfer?fromAccountId={{toAccountId}}&toAccountId={{fromAccountId}}&amount={{overdraftAmount}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transfer"
              ],
              "query": [
                {
                  "key": "fromAccountId",
                  "value": "{{toAccountId}}"
                },
                {
                  "key": "toAccountId",
                  "value": "{{fromAccountId}}"
                },
                {
                  "key": "amount",
                  "value": "{{overdraftAmount}}"
                }
              ]
            },
            "description": "Sends the savings balance plus $500 from the new savings account, so only the throwaway account goes negative."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const snapshot = JSON.parse(pm.collectionVariables.get('snapshot'));",
                  "const balance = snapshot[pm.collectionVariables.get('toAccountId')] / 100;",
                  "pm.collectionVariables.set('overdraftAmount', String(balance + 500));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const amount = Number(pm.collectionVariables.get('overdraftAmount'));",
                  "const from = pm.collectionVariables.get('toAccountId');",
                  "const to = pm.collectionVariables.get('fromAccountId');",
                  "pm.test('BUG-PB-004 still reproduces: transfer above the balance is accepted', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.text()).to.include('Successfully transferred');",
                  "});",
                  "pm.collectionVariables.set('expectedChange', JSON.stringify({ [from]: -amount, [to]: amount }));"
                ]
              }
            }
          ]
        },
