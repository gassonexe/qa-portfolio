{
  "name": "yettel-webshop-playwright",
  "version": "1.0.0",
  "description": "Playwright + TypeScript UI test suite for the Yettel Serbia webshop catalog",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke",
    "test:e2e": "playwright test tests/e2e",
    "test:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "keywords": ["playwright", "typescript", "e2e", "qa"],
  "author": "Luka Galonjic",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
